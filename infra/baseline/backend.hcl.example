# Purpose: supply reviewed baseline initialization or planning settings.
# Inputs: non-secret account/region/profile/role values or explicit review variables.
# Outputs: values consumed by Terraform; this example does not apply infrastructure.
# Bootstrap this dedicated bucket only after the reviewed deployment plan is approved.
bucket       = "dissertation-653464153304-us-east-2-state"
key          = "dissertation/653464153304/us-east-2/baseline/terraform.tfstate"
region       = "us-east-2"
profile      = "dissertation"
allowed_account_ids = ["653464153304"]
encrypt      = true
use_lockfile = true
workspace_key_prefix = "dissertation/653464153304/us-east-2/baseline/workspaces"
assume_role = {
  role_arn = "arn:aws:iam::653464153304:role/dissertation-paused-baseline-deploy"
  session_name = "dissertation-baseline-state"
}
