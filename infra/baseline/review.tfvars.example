# Purpose: supply reviewed baseline initialization or planning settings.
# Inputs: non-secret account/region/profile/role values or explicit review variables.
# Outputs: values consumed by Terraform; this example does not apply infrastructure.
# Example proposal only; replace the alert destination and review costs before deployment.
region                    = "us-east-2"
aws_profile               = "dissertation"
budget_email              = "REPLACE_WITH_REVIEWED_EMAIL"
monthly_budget_usd        = 100
# Input: explicit service-stage intent. Output: all monitoring remains paused until separately approved.
enable_collection         = false
enable_config_recording   = false
enable_cloudtrail_logging = false
enable_cspm_standard      = false
enabled_security_controls = ["S3.5", "S3.8"]
